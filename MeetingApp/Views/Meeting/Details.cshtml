@model UserInfo 
@{
    ViewBag.Title = "Participant Details";
}

@{
    var classname = Model.WillAttend == true ? "primary" : "danger";
}

<main class="text-center">
    <h1 class="h4">Participant Details</h1>
    <p>
       <span class="badge text-bg-@classname">
        @if(Model.WillAttend == true) {
            <text>Will Attend</text>
        } else {
            <text>Will Not Attend</text>
        }      
           
        </span>
    </p>
    <p>Name: @Model.Name</p>
    <p>Email: @Model.Email</p>
    <p>Phone: @Model.Phone</p>
    <a asp-controller="Meeting" asp-action="List" class="btn btn-outline-@classname">Participants List</a>

</main>