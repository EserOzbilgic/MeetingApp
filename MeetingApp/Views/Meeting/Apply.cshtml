@model UserInfo
@{
    ViewBag.Title = "Apply Form";
}

<h1 class="h4 text-center">Meeting Application Form</h1>
<form method="post" action="/meeting/Apply">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name Surname</label>
        <input asp-for="Name" class="form-control"/>

    </div>
    <div class="mb-3">
    <label asp-for="Phone" class="form-label">Phone</label>

    <div class="input-group">
        <select class="form-select"
                id="countryCode"
                style="max-width: 150px;"
                onchange="updatePlaceholder(); showPhoneSpinner()">

            <optgroup label="Popular">
                <option value="+90">🇹🇷 Turkey (+90)</option>
                <option value="+1">🇺🇸 USA (+1)</option>
                <option value="+44">🇬🇧 UK (+44)</option>
                <option value="+49">🇩🇪 Germany (+49)</option>
                <option value="+33">🇫🇷 France (+33)</option>
            </optgroup>

            <optgroup label="Other">
                <option value="+39">🇮🇹 Italy (+39)</option>
                <option value="+34">🇪🇸 Spain (+34)</option>
                <option value="+31">🇳🇱 Netherlands (+31)</option>
                <option value="+46">🇸🇪 Sweden (+46)</option>
                <option value="+47">🇳🇴 Norway (+47)</option>
                <option value="+41">🇨🇭 Switzerland (+41)</option>
                <option value="+43">🇦🇹 Austria (+43)</option>
                <option value="+7">🇷🇺 Russia (+7)</option>
                <option value="+81">🇯🇵 Japan (+81)</option>
                <option value="+82">🇰🇷 South Korea (+82)</option>
                <option value="+86">🇨🇳 China (+86)</option>
                <option value="+91">🇮🇳 India (+91)</option>
                <option value="+61">🇦🇺 Australia (+61)</option>
                <option value="+55">🇧🇷 Brazil (+55)</option>
                <option value="+52">🇲🇽 Mexico (+52)</option>
            </optgroup>
            <optgroup label="Asia">
    <option value="+86">🇨🇳 China (+86)</option>
    <option value="+91">🇮🇳 India (+91)</option>
    <option value="+81">🇯🇵 Japan (+81)</option>
    <option value="+82">🇰🇷 South Korea (+82)</option>
    <option value="+62">🇮🇩 Indonesia (+62)</option>
    <option value="+92">🇵🇰 Pakistan (+92)</option>
    <option value="+880">🇧🇩 Bangladesh (+880)</option>
    <option value="+84">🇻🇳 Vietnam (+84)</option>
    <option value="+66">🇹🇭 Thailand (+66)</option>
    <option value="+60">🇲🇾 Malaysia (+60)</option>
    <option value="+65">🇸🇬 Singapore (+65)</option>
    <option value="+63">🇵🇭 Philippines (+63)</option>
    <option value="+98">🇮🇷 Iran (+98)</option>
    <option value="+966">🇸🇦 Saudi Arabia (+966)</option>
    <option value="+971">🇦🇪 UAE (+971)</option>
    <option value="+972">🇮🇱 Israel (+972)</option>
</optgroup>
            <optgroup label="Africa">
    <option value="+20">🇪🇬 Egypt (+20)</option>
    <option value="+27">🇿🇦 South Africa (+27)</option>
    <option value="+234">🇳🇬 Nigeria (+234)</option>
    <option value="+254">🇰🇪 Kenya (+254)</option>
    <option value="+212">🇲🇦 Morocco (+212)</option>
    <option value="+216">🇹🇳 Tunisia (+216)</option>
    <option value="+213">🇩🇿 Algeria (+213)</option>
    <option value="+233">🇬🇭 Ghana (+233)</option>
    <option value="+251">🇪🇹 Ethiopia (+251)</option>
    <option value="+255">🇹🇿 Tanzania (+255)</option>
</optgroup>

        </select>

        <input type="tel"
               class="form-control"
               name="Phone"
               id="Phone"
               placeholder="5xx xxx xx xx"
               oninput="showPhoneSpinner()" />

        <span class="input-group-text d-none" id="phoneSpinner">
            <span class="spinner-border spinner-border-sm text-primary"></span>
        </span>
    </div>
</div>


     <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control"/>
    </div>
     <div class="mb-3">
        <label asp-for="WillAttend" class="form-label">Participation Status</label>
        <select asp-for="WillAttend" class="form-select">
            <option value="true">Yes I will attend</option>
            <option value="false">No I won't attend</option>
        </select>
    </div>
    <button class="btn btn-outline-primary" type="submit">Save</button>
</form>

<script>
    let phoneTimer;

const placeholders = {
    "+90": "5xx xxx xx xx",
    "+91": "xxxxx xxxxx",
    "+86": "1xx xxxx xxxx",
    "+81": "90 xxxx xxxx",
    "+82": "10 xxxx xxxx",
    "+966": "5x xxx xxxx",
    "+971": "5x xxx xxxx"
};
    function updatePlaceholder() {
        const code = document.getElementById("countryCode").value;
        document.getElementById("Phone").placeholder =
            placeholders[code] || "Phone number";
    }   

    function showPhoneSpinner() {
        const spinner = document.getElementById("phoneSpinner");
        spinner.classList.remove("d-none");

        clearTimeout(phoneTimer);
        phoneTimer = setTimeout(() => {
            spinner.classList.add("d-none");
        }, 600);
    }
</script>
