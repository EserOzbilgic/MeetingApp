@model List<UserInfo>
@{
    ViewBag.Title = "Participants List";
}
<main class="text-center">
<h1 class="h4">Participants List</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <td>Participant Name</td>
            <td>Status</td>
            <td></td>
        </tr>
    </thead>
    <tbody>

        @{ int i = 0; }


        @foreach (var user in Model) {
        var status = user.WillAttend == true? "Yes":"No";
        var classname = user.WillAttend == true? "table-success":"table-danger";

        if(user.WillAttend == true) {
            i++;
        }


         <tr class="@classname">
            <td>@user.Name</td>
            <td>@status</td>
            <td>
                <a class="btn btn-sm btn-primary" href="/meeting/details/@user.Id">View Details</a>
            </td>  
        </tr>
        }
         
    </tbody>
</table>

<div class="card">
    <div class="card-body">
        <span>Participants: @i</span>
    </div>
</div>

</main>
